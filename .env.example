# Copy this file to .env and fill in real values. .env is gitignored -- never commit real secrets.

# From developer.ebay.com -> Your App Keys (production keyset).
EBAY_CLIENT_ID=your_app_id_here
EBAY_CLIENT_SECRET=your_cert_id_here

# Classic GitHub Personal Access Token with the "gist" scope.
# (Fine-grained PATs do not support the Gists API as of this writing.)
GITHUB_TOKEN=your_github_pat_here
